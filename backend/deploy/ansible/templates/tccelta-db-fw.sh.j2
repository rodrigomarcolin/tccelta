#!/bin/sh
# Gerado pelo Ansible. Libera a 5432 so para os IPs de /etc/tccelta/dbeaver-allowlist.txt.
# A cadeia e reescrita numa unica transacao (iptables-restore --noflush): nunca fica vazia nem sem o DROP final,
# e uma entrada invalida rejeita a transacao inteira, mantendo a cadeia anterior.
set -eu
IF={{ ansible_default_ipv4.interface }}
ALLOW=/etc/tccelta/dbeaver-allowlist.txt
{
  echo '*filter'
  echo ':TCCELTA-DB - [0:0]'
  echo '-F TCCELTA-DB'
  while read -r ip _; do
    case "$ip" in ''|\#*) continue;; esac
    echo "-A TCCELTA-DB -s $ip -j RETURN"
  done < "$ALLOW"
  echo '-A TCCELTA-DB -j DROP'
  echo 'COMMIT'
} | iptables-restore --noflush
# o salto so e criado depois de a cadeia existir e terminar em DROP
iptables -C DOCKER-USER -i "$IF" -p tcp -m conntrack --ctorigdstport 5432 -j TCCELTA-DB 2>/dev/null || \
  iptables -I DOCKER-USER 1 -i "$IF" -p tcp -m conntrack --ctorigdstport 5432 -j TCCELTA-DB
