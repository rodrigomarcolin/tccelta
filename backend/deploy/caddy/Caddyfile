{
	admin off
	servers {
		protocols h1 h2
	}
}

{$API_HOST}:8443 {
	tls {$CADDY_TLS}
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	handle /api/visitantes* {
		reverse_proxy visitantes:8082
	}
	handle_path /api/* {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {remote_host}
		}
	}
	# transicao: clientes antigos (app) ainda chamam sem o prefixo /api
	@legado path /v1/* /saude/*
	handle @legado {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		root * /srv/site
		file_server
	}
	log {
		output stdout
		format json
	}
}

# Atras do tunel (perfil `tunel`): HTTP puro na rede `borda`, sem porta publicada.
:8081 {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	handle /api/visitantes* {
		reverse_proxy visitantes:8082
	}
	handle_path /api/* {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}
	# transicao: clientes antigos (app) ainda chamam sem o prefixo /api
	@legado path /v1/* /saude/*
	handle @legado {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}
	handle {
		root * /srv/site
		file_server
	}
	log {
		output stdout
		format json
	}
}
