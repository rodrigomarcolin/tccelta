{
	admin off
	default_sni {$API_HOST}
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$API_HOST} {
	tls internal
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	handle /api/visitantes* {
		reverse_proxy visitantes:8082
	}
	handle_path /api/* {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {remote_host}
		}
	}
	# transicao: clientes antigos (app) ainda chamam sem o prefixo /api
	@legado path /v1/* /saude/*
	handle @legado {
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			health_uri /saude/pronta
			health_interval 10s
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		root * /srv/site
		file_server
	}
	log {
		output stdout
		format json
	}
}
