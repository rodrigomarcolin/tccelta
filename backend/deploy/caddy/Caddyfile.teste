{
	admin off
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$API_HOST} {
	tls internal
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy {
		dynamic a {
			name api
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		health_uri /saude/pronta
		health_interval 10s
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format json
	}
}
