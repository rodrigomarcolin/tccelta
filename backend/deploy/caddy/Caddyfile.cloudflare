{
	admin off
	servers {
		protocols h1 h2
		# So confia nos cabecalhos de IP de quem vem da Cloudflare (faixas de https://www.cloudflare.com/ips).
		# Qualquer outra origem tem o CF-Connecting-IP ignorado, entao ninguem forja o IP do cliente.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Atras do proxy da Cloudflare (modo SSL "Full (strict)"): o certificado e o de origem da Cloudflare,
# gravado em deploy/caddy/certs/ pelo Ansible. Nao ha pedido ao Let's Encrypt.
{$API_HOST} {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin-key.pem
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy {
		dynamic a {
			name api
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		health_uri /saude/pronta
		health_interval 10s
		# IP do cliente (CF-Connecting-IP, validado por trusted_proxies), nao o da Cloudflare.
		header_up X-Real-IP {client_ip}
	}
	log {
		output stdout
		format json
	}
}
