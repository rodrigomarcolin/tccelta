AMBIENTE=dev
IMG_TIMESCALE=timescale/timescaledb-ha:pg17
VAULT_VERSAO=1.18
API_REPLICAS=2
# Portas do host da API, uma por réplica. Com API_REPLICAS=1, fixe uma só (API_PORTAS=8080) para o endereço não variar.
API_PORTAS=8080-8081
API_HOST=localhost
API_PORTA_TLS=8443
CADDY_TLS=internal
JWT_ROTACAO_PERIODO=720h
CLOUDFLARED_VERSAO=2024.12.2
TUNEL_HOSTNAME=
PROXIES_CONFIAVEIS=172.30.10.0/24
LOG_NIVEL=info
LOG_FORMATO=json
JWT_VALIDADE=1h
JWT_FOLGA=30s
VIAGEM_ESPERA_SEM_LOTE=10s
VIAGEM_LIMITE_FINAL=20s
VIAGEM_INTERVALO_AVALIACAO=1s
VIAGEM_INTERVALO_PROVISORIAS=5s
VIAGEM_TIMEOUT_CALCULO=60s
LIMITE_VIAGEM_IP_MIN=600
# client credentials (API3): aud e validade do token de cliente, rotação da chave cli (KMS) e bloqueio progressivo de POST /v1/auth/token
JWT_AUDIENCIA_ANALISE=tccelta-analise
CLI_JWT_VALIDADE=30m
CLI_JWT_ROTACAO_PERIODO=720h
TOKEN_BLOQUEIO_TOLERANCIA_PAR=5
TOKEN_BLOQUEIO_TOLERANCIA_IP=20
TOKEN_BLOQUEIO_INICIAL=30s
TOKEN_BLOQUEIO_FATOR=2
