' Diagrama de sequência do handshake do ponto de vista do servidor
' (API, banco de dados e worker da camada gold)
' Usado em: latex/aux-docs/segunraca-dongle-server.tex (fig:handshake-servidor)
' Gerar PNG (Git Bash): ./generate.sh handshake-servidor.puml
@startuml handshake-servidor
skinparam defaultFontSize 14
skinparam dpi 200
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFF4E0
skinparam noteBorderColor #C77700

participant "App" as A
participant "API" as S
database "PostgreSQL" as DB
participant "Worker" as W

== POST /v1/dongles/{id}/desafio ==

A -> S : pedido de desafio (DevId)
note over S
  Sem autenticação: só o dongle
  com K_auth consegue responder.
end note

S -> S : limita taxa por DevId\n(429 se exceder)
S -> DB : UPDATE dongle_estado\nSET ultimo_c_s = ultimo_c_s + 1\nRETURNING ultimo_c_s
DB -> S : c_S
S -> S : gera N_S (16 bytes,\ncrypto/rand)

note over S
  **S1** = relógio da API
  (time.Now(), antes do INSERT)
end note

S -> DB : INSERT INTO desafio\n(dongle_id, c_s, nonce, s1, expira_em)
S -> A : Desafio 0x01\n(c_S, N_S, tag K_auth)

== POST /v1/dongles/{id}/desafio/resposta ==

A -> S : Resposta 0x02\n(c_S, N_S, TAIL_seq, HEAD_seq,\nboot_id, t_ms, tag K_auth)

note over S
  **S2** = relógio da API
  (anotado na chegada,\nantes de processar)
end note

S -> S : verifica tag com K_auth do dongle
alt tag inválida
  S -> DB : UPDATE desafio\nresultado = tag_invalida
  S -> A : 422
end

S -> DB : UPDATE desafio\nSET respondido_em = S2, boot_id, t_ms,\nhead_seq, tail_seq\nWHERE dongle_id, c_s, nonce,\nrespondido_em IS NULL, expira_em > S2
alt nenhuma linha afetada
  DB -> S : 0 linhas
  S -> A : 409 (desafio desconhecido,\nvencido ou já usado)
end
DB -> S : RETURNING s1

S -> S : confere consistência:\nTAIL_seq <= HEAD_seq + 1\nHEAD_seq >= salvo
alt inconsistente
  S -> DB : resultado = inconsistente
  S -> A : 422
end

S -> S : confere S2 - S1 <= 2s
alt latência alta
  S -> DB : resultado = aceito_sem_ancora
  note right of S
    Handshake segue sem âncora;
    ACK pede novo desafio.
  end note
end

group transação (pg_advisory_xact_lock(dongle_id))
  S -> DB : BEGIN
  S -> DB : pg_advisory_xact_lock(dongle_id)
  alt TAIL_seq > seq_contiguo + 1
    S -> DB : INSERT INTO lacuna\n(causa = OVERFLOW, from_seq, to_seq, c_s)
    S -> DB : avança seq_contiguo\npara TAIL_seq - 1
    note right of DB
      Flash cheia descartou blocos:
      perda declarada e autenticada.
    end note
  end
  S -> DB : UPDATE dongle_estado\n(head_seq, tail_seq, head_relatado_em)
  S -> DB : INSERT INTO ancora_tempo\n(se S2 - S1 <= 2s)
  S -> DB : INSERT INTO boot\n(se ainda não existir)
  S -> DB : marca boot como pendente
  S -> DB : UPDATE desafio\nresultado = aceito
  S -> DB : COMMIT
end

S -> W : NOTIFY
S -> S : emite JWT (sub = DevId,\njti gravado em desafio.token_jti)
S -> A : ACK 0x04\n(ACK_seq, tag K_auth) + token JWT

...

W -> DB : SELECT boot pendente\nFOR UPDATE SKIP LOCKED
W -> DB : lê ancora_tempo do boot
W -> W : recalcula a_ms, b,\nincerteza_base_ms
W -> DB : UPDATE boot\n(colunas de tempo)
W -> W : recalcula camada gold do boot
W -> DB : libera o boot
@enduml
