# Todas lidas em runtime, só no servidor. Não use o prefixo NEXT_PUBLIC_.
AUTH_SECRET=
# URL publica do Auth.js, COM o caminho: o next-auth usa o pathname de AUTH_URL como basePath dele
# (o app roda em /dashboard). Em dev: http://localhost:3000/dashboard/api/auth
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OPERATOR_EMAILS=
ANALISE_FONTE_DADOS=
ANALISE_API_URL=
ANALISE_TIMEOUT_MS=
ANALISE_DONGLE_ID=
# Client credentials da API de viagens (INT2): só servidor, lidas em runtime, nunca NEXT_PUBLIC_.
# Em dev: ANALISE_CLIENT_ID=next-dev e o segredo gerado por `make seed-client` (backend/deploy/segredos/analise_cliente_secret).
ANALISE_CLIENT_ID=
ANALISE_CLIENT_SECRET=
