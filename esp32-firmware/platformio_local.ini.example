; Configuração local, fora do git: copie para platformio_local.ini.
; Vale para todos os ambientes que estendem [base].

[base]
; Porta do ESP32 nesta máquina (Windows: COMx; Linux/WSL: /dev/ttyUSB0).
upload_port  = COM9
monitor_port = COM9

; Teste "de fábrica": apaga os blocos e o seq a cada boot (boot_id e a
; configuração são mantidos). Não deixe ligado: impede testar a recuperação
; após reinício.
; build_flags = -DCOLLECTOR_WIPE_ON_BOOT

; Pareamento: tempos curtos para bancada (mantenha o MAX_BONDS).
; [pairing]
; build_flags =
;     -DPAIR_BUTTON_HOLD_MS=2000
;     -DPAIR_WINDOW_MS=20000
;     -DCONFIG_BT_NIMBLE_MAX_BONDS=1
;     -DMYNEWT_VAL_BLE_SM_MAX_PROCS=3

; Log de blocos: fixa o limite N (bancada), para provocar SEG_DROP sem encher a flash.
; [block_log]
; build_flags =
;     -DBLOCK_LOG_MAX_BLOCKS=200
