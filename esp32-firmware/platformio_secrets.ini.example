; platformio_secrets.ini
;
; THIS FILE IS GITIGNORED — do not commit it.
;
; Copy this file from platformio_secrets.ini.example and fill in your key.
;
; Override SECURE_PSK_HEX for each PSK environment you actually use.
; Run `openssl rand -hex 32` to generate a cryptographically-random 256-bit key.
;
; Example:
;
; [env:mock_psk]
; build_flags =
;     ${env:_secure_psk_base.build_flags}
;     -DUSE_MOCK
;     -DSECURE_PSK_HEX=<your-64-hex-chars>
;
; [env:twai_psk]
; build_flags =
;     ${env:_secure_psk_base.build_flags}
;     -DUSE_TWAI
;     -DUSE_OBD2_REAL
;     -DSECURE_PSK_HEX=<your-64-hex-chars>
;
; [env:mcp2515_psk]
; build_flags =
;     ${env:_secure_psk_base.build_flags}
;     -DUSE_MCP2515
;     -DUSE_OBD2_REAL
;     -DSECURE_PSK_HEX=<your-64-hex-chars>
